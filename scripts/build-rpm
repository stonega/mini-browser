#!/usr/bin/env python3
"""Build local binary/source RPMs from an explicit source-only archive."""

import json
import shutil
import subprocess
import tarfile
import tomllib
from pathlib import Path

project = Path(__file__).resolve().parent.parent
metadata = tomllib.loads((project / "pyproject.toml").read_text())
version = metadata["project"]["version"]
name = "mini-browser"
top = project / "build/rpm"
for directory in ["SOURCES", "SPECS", "BUILD", "BUILDROOT", "RPMS", "SRPMS"]:
    (top / directory).mkdir(parents=True, exist_ok=True)

source = top / f"SOURCES/{name}-{version}.tar.gz"
files = {project / name for name in ["README.md", "COPYING", "AGENTS.md", "pyproject.toml"]}
for directory in ["src", "tests", "docs", "examples", "scripts", "packaging", "native"]:
    for path in (project / directory).rglob("*"):
        if path.is_file() and "__pycache__" not in path.parts and path.suffix != ".pyc":
            files.add(path)
files.update(
    project / "data" / filename
    for filename in [
        "io.github.stone.MiniBrowser.desktop",
        "io.github.stone.MiniBrowser.svg",
    ]
)
files.update(path for path in (project / "data/gnome-shell").rglob("*") if path.is_file())
with tarfile.open(source, "w:gz") as archive:
    for path in sorted(files):
        archive.add(path, arcname=f"{name}-{version}/{path.relative_to(project)}", recursive=False)

# Include both pinned SDKs so one source RPM can build every enabled COPR target.
release = json.loads((project / "native/cef/release.json").read_text())
for architecture, distribution in release["architectures"].items():
    subprocess.run(
        [
            str(project / "scripts/build-cef"),
            "--download-only",
            "--architecture",
            architecture,
        ],
        check=True,
    )
    sdk_name = f"cef_binary_{release['version']}_{distribution['platform']}_minimal.tar.bz2"
    shutil.copy2(project / "build" / sdk_name, top / "SOURCES" / sdk_name)

spec = top / "SPECS/mini-browser.spec"
shutil.copy2(project / "packaging/mini-browser.spec", spec)
# CEF is large; moderate zstd compression keeps local rebuilds practical.
subprocess.run(
    [
        "rpmbuild",
        "-ba",
        "--define",
        f"_topdir {top}",
        "--define",
        "_binary_payload w7.zstdio",
        "--define",
        "_source_payload w1.zstdio",
        str(spec),
    ],
    check=True,
)
output = project / "dist"
output.mkdir(exist_ok=True)
for directory in [top / "RPMS", top / "SRPMS"]:
    for rpm in sorted(directory.rglob(f"{name}-{version}-*.rpm")):
        target = output / rpm.name
        shutil.copy2(rpm, target)
        print(target)
